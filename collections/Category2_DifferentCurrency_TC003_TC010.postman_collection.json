  "item": [
    {
      "name": "1. Create Corporate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var testCaseId  = pm.collectionVariables.get('testCaseId');",
              "var dialCodeMap = JSON.parse(pm.collectionVariables.get('__dialCodeMap__'));",
              "var timezoneMap = JSON.parse(pm.collectionVariables.get('__timezoneMap__'));",
              "",
              "// ── Unique Transaction ID ───────────────────────────────────",
              "var txnId = 'TXN_' + Date.now() + '_' + Math.random().toString(36).substr(2,5).toUpperCase();",
              "pm.collectionVariables.set('transactionId', txnId);",
              "",
              "// ── Corporate Code (unique per run) ────────────────────────",
              "var ts       = Date.now().toString().slice(-6);",
              "var corpCode = 'Corp_' + testCaseId.replace('TC_','') + '_' + ts;",
              "pm.collectionVariables.set('corpCode', corpCode);",
              "",
              "// ── Timezone ────────────────────────────────────────────────",
              "var mapped = timezoneMap[pm.collectionVariables.get('corpTimezone')] || 'UTC';",
              "pm.collectionVariables.set('mappedCorpTimezone', mapped);",
              "",
              "// ── Currency Symbol ─────────────────────────────────────────",
              "pm.collectionVariables.set('corpCurrencySymbol', pm.collectionVariables.get('corpCurrency'));",
              "",
              "// ── Dial Code ───────────────────────────────────────────────",
              "var dialCode = dialCodeMap[pm.collectionVariables.get('corpCountry')] || '+1';",
              "pm.collectionVariables.set('corpDialCode', dialCode);",
              "",
              "console.log('[' + testCaseId + '] Create Corporate => ' + corpCode + ' | TxnId: ' + txnId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create Corporate - Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Create Corporate - Success', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.successCode).to.eql(1);",
              "    pm.collectionVariables.set('corporateId', json.corporateId);",
              "    console.log('[' + pm.collectionVariables.get('testCaseId') + '] Corporate ID: ' + json.corporateId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corporateCode\": \"{{corpCode}}\",\n  \"corporateName\": \"Corp {{corpCode}}\",\n  \"corporateDescription\": \"Auto created for {{testCaseId}} | TxnId: {{transactionId}}\",\n  \"corporateStatus\": \"Active\",\n  \"firstName\": \"Auto\",\n  \"lastName\": \"Corp\",\n  \"addressLine1\": \"Test Address Line 1\",\n  \"addressLine2\": null,\n  \"city\": \"Test City\",\n  \"stateProvince\": \"Test State\",\n  \"postalCode\": \"10001\",\n  \"countryCode\": \"{{corpCountry}}\",\n  \"dialCode\": \"{{corpDialCode}}\",\n  \"dialCountryCode\": \"{{corpCountry}}\",\n  \"mobileNumber\": \"9000000001\",\n  \"contactEmail\": \"corp.{{corpCode}}@test.com\",\n  \"timezone\": \"{{mappedCorpTimezone}}\",\n  \"dateFormat\": \"{{corpDateFormat}}\",\n  \"timeFormat\": \"hh:mm a\",\n  \"enableSsoLogin\": false,\n  \"b2cInstance\": null,\n  \"b2cDomainName\": null,\n  \"b2cSigninSignupPolicy\": null,\n  \"b2cClientId\": null,\n  \"sessionTimeoutLimit\": null,\n  \"enableMfa\": false,\n  \"otpMaxAttempts\": null,\n  \"otpExpirationTime\": null,\n  \"passwordExpirationPeriod\": null,\n  \"currencySymbol\": \"{{corpCurrencySymbol}}\",\n  \"currencyRoundOff\": \"{{corpDecimals}}\",\n  \"createdBy\": {{loggedInUserId}},\n  \"requestedBy\": {{loggedInUserId}}\n}"
        },
        "url": {
          "raw": "https://aks-crs-qa.hospitalityrevolution.com/api/v1.0/Corporates/createcorporate",
          "protocol": "https",
          "host": ["aks-crs-qa", "hospitalityrevolution", "com"],
          "path": ["api", "v1.0", "Corporates", "createcorporate"]
        }
      }
    },
