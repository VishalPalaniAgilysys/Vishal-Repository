      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate unique x-transaction-id",
              "pm.collectionVariables.set('txnId_rp', require('uuid').v4());",
              "",
              "// Dynamic rate plan code: RP_<testCaseId>_<last5digits of timestamp>",
              "var testCaseId = pm.iterationData.get('testCaseId');",
              "var suffix = Date.now().toString().slice(-5);",
              "var rpCode = 'RP_' + testCaseId.replace('TC_', '') + '_' + suffix;",
