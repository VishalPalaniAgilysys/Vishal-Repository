        "method": "POST",
        "header": [
          { "key": "Content-Type",     "value": "application/json" },
          { "key": "Authorization",    "value": "Bearer {{authToken}}" },
          { "key": "x-transaction-id", "value": "{{txnId_rp}}" },
          { "key": "x-session-id",     "value": "session-{{ratePlanCode}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corporateId\": {{corporateId}},\n  \"brandId\": {{brandId}},\n  \"hotelGroupId\": {{hotelGroupId}},\n  \"hotelId\": {{hotelId}},\n  \"ratePlanCode\": \"{{ratePlanCode}}\",\n  \"ratePlanName\": \"{{ratePlanName}}\",\n  \"ratePlanStatus\": 10,\n  \"effectiveStartDate\": \"{{rpEffectiveStartDate}}\",\n  \"effectiveEndDate\": null,\n  \"currencyCode\": \"{{rpCurrencyCode}}\",\n  \"createdBy\": {{loggedInUserId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/RatePlans/createRatePlan",
          "host": ["{{baseUrl}}"],
          "path": ["RatePlans", "createRatePlan"]
        }
      }
    },
    {
      "name": "7. Create Channel",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate unique x-transaction-id",
              "pm.collectionVariables.set('txnId_ch', require('uuid').v4());",
              "",
              "// Dynamic channel code: CH_<testCaseId>_<last5digits of timestamp>",
              "var testCaseId = pm.iterationData.get('testCaseId');",
              "var suffix = Date.now().toString().slice(-5);",
              "var channelCode = 'CH_' + testCaseId.replace('TC_', '') + '_' + suffix;",
              "pm.collectionVariables.set('channelCode', channelCode);",
              "",
              "// Channel country dial code (use corp country as fallback)",
              "var corpCountry = pm.iterationData.get('corpCountry');",
              "var dialCodeMap = {",
              "    'USA': '+1', 'IND': '+91', 'GBR': '+44',",
              "    'SGP': '+65', 'AUS': '+61', 'DEU': '+49',",
              "    'ARE': '+971', 'KOR': '+82', 'JPN': '+81'",
              "};",
              "pm.collectionVariables.set('channelDialCode', dialCodeMap[corpCountry] || '+1');",
              "pm.collectionVariables.set('channelDialCountryCode', corpCountry || 'USA');",
              "",
              "console.log('[' + testCaseId + '] Creating Channel: ' + channelCode + ' | CorporateId: ' + pm.collectionVariables.get('corporateId'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create Channel - Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Create Channel - Success', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.successCode).to.eql(1);",
              "    pm.collectionVariables.set('corporateChannelId', jsonData.corporateChannelId);",
              "    console.log('Corporate Channel ID set: ' + jsonData.corporateChannelId);",
              "    console.log('=== TC FULLY COMPLETED: ' + pm.iterationData.get('testCaseId') + ' ===');",
              "    console.log('Final Summary => CorpId: ' + pm.collectionVariables.get('corporateId') +",
              "                ' | BrandId: ' + pm.collectionVariables.get('brandId') +",
              "                ' | HGId: ' + pm.collectionVariables.get('hotelGroupId') +",
              "                ' | HotelId: ' + pm.collectionVariables.get('hotelId') +",
              "                ' | RatePlanId: ' + pm.collectionVariables.get('ratePlanId') +",
              "                ' | ChannelId: ' + jsonData.corporateChannelId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",     "value": "application/json" },
          { "key": "Authorization",    "value": "Bearer {{authToken}}" },
          { "key": "x-transaction-id", "value": "{{txnId_ch}}" },
          { "key": "x-session-id",     "value": "session-{{channelCode}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corporateId\": {{corporateId}},\n  \"connectivityPartner\": \"CRS\",\n  \"channelCode\": \"{{channelCode}}\",\n  \"channelName\": \"Channel {{channelCode}}\",\n  \"channelType\": \"OTA\",\n  \"channelMode\": \"Push\",\n  \"source\": \"CRS\",\n  \"region\": null,\n  \"corporateChannelStatus\": \"Active\",\n  \"priorityRanking\": true,\n  \"channelDescription\": \"Auto created channel for {{testCaseId}}\",\n  \"channelContactFirstName\": \"Channel\",\n  \"channelContactLastName\": \"Auto\",\n  \"channelContactEmail\": \"channel.{{channelCode}}@test.com\",\n  \"dialCode\": \"{{channelDialCode}}\",\n  \"dialCountryCode\": \"{{channelDialCountryCode}}\",\n  \"channelContactPhone\": \"9000000005\",\n  \"createdBy\": {{loggedInUserId}},\n  \"settings\": null,\n  \"connectivity\": null\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/CorporateChannels/createcorporatechannel",
          "host": ["{{baseUrl}}"],
          "path": ["CorporateChannels", "createcorporatechannel"]
        }
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{authToken}}", "type": "string" }
    ]
  }
}