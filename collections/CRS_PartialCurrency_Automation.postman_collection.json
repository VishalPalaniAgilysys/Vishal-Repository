              "pm.collectionVariables.set('brandCountry',        brandCountry);",
              "",
              "console.log('[' + testCaseId + '] Creating Brand: ' + brandCode +",
              "    ' | dialCC=' + alpha2 + ' | CorporateId: ' + pm.collectionVariables.get('corporateId'));"
