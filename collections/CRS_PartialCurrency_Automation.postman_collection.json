      "name": "5. Create Hotel",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "  var brandId = pm.collectionVariables.get('brandId');",
              "  if (!brandId) { console.warn('⚠️ brandId is empty! Create Brand may have failed.'); }",
              "var uuid = require('uuid');",
              "pm.collectionVariables.set('txnId_hotel', uuid.v4());",
              "",
              "var alpha3ToAlpha2 = {",
              "    'USA': 'US', 'IND': 'IN', 'GBR': 'GB', 'SGP': 'SG',",
              "    'AUS': 'AU', 'DEU': 'DE', 'ARE': 'AE', 'KOR': 'KR', 'JPN': 'JP'",
              "};",
              "var dialCodeMap = {",
              "    'USA': '+1',  'IND': '+91', 'GBR': '+44', 'SGP': '+65',",
              "    'AUS': '+61', 'DEU': '+49', 'ARE': '+971','KOR': '+82', 'JPN': '+81'",
              "};",
              "var timezoneMap = {",
              "    'UTC-05:00': 'EDT', 'UTC+05:30': 'IST', 'UTC+00:00': 'UTC',",
              "    'UTC+01:00': 'CET', 'UTC+04:00': 'GST', 'UTC+08:00': 'SGT',",
              "    'UTC+09:00': 'JST', 'UTC+10:00': 'AEST'",
              "};",
              "",
              "// ── NULL-SAFE fetch ───────────────────────────────────────────",
              "var testCaseId    = pm.iterationData.get('testCaseId')     || 'STANDALONE';",
              "var hotelTimezone = pm.iterationData.get('hotelTimezone')  || 'UTC+00:00';",
              "var hotelCurrency = pm.iterationData.get('hotelCurrency')  || 'USD';",
              "var hotelCountry  = pm.iterationData.get('hotelCountry')   || 'USA';",
              "var hotelDateFmt  = pm.iterationData.get('hotelDateFormat')|| 'MM/DD/YYYY';",
              "var hotelTimeFmt  = pm.iterationData.get('hotelTimeFormat')|| 'HH:mm';",
              "var hotelDecimals = pm.iterationData.get('hotelDecimals') != null",
              "                    ? String(pm.iterationData.get('hotelDecimals')) : '2';",
              "",
              "// ── Dynamic hotel code & name ─────────────────────────────────",
              "var suffix    = Date.now().toString().slice(-5);",
              "var hotelCode = 'HTL_' + testCaseId.replace('TC_', '') + '_' + suffix;",
              "var hotelName = 'Hotel ' + testCaseId + ' ' + suffix;",
              "",
              "var alpha2   = alpha3ToAlpha2[hotelCountry] || 'US';",
              "var dialCode = dialCodeMap[hotelCountry]    || '+1';",
              "var timezone = timezoneMap[hotelTimezone]   || 'UTC';",
              "",
              "pm.collectionVariables.set('hotelCode',            hotelCode);",
              "pm.collectionVariables.set('hotelName',            hotelName);",
              "pm.collectionVariables.set('hotelCountryCode',     hotelCountry);   // alpha-3",
              "pm.collectionVariables.set('hotelDialCode',        dialCode);",
              "pm.collectionVariables.set('hotelDialCountryCode', alpha2);          // alpha-2",
              "pm.collectionVariables.set('mappedHotelTimezone',  timezone);",
              "pm.collectionVariables.set('hotelCurrencySymbol',  hotelCurrency);",
              "pm.collectionVariables.set('hotelDateFormat',      hotelDateFmt);",
              "pm.collectionVariables.set('hotelTimeFormat',      hotelTimeFmt);",
              "pm.collectionVariables.set('hotelDecimals',        hotelDecimals);",
              "",
              "console.log('[' + testCaseId + '] Creating Hotel: ' + hotelCode +",
              "    ' | country=' + hotelCountry + ' | dialCC=' + alpha2 +",
              "    ' | tz=' + timezone + ' | dateFormat=' + hotelDateFmt +",
              "    ' | timeFormat=' + hotelTimeFmt + ' | decimals=' + hotelDecimals);"
