    {
      "name": "1. Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate unique x-transaction-id for Login",
              "pm.collectionVariables.set('txnId_login', require('uuid').v4());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login - Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Login - Success and token extracted', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.successCode).to.eql(1);",
              "",
              "    // Store userId and corporateId from login response",
              "    pm.collectionVariables.set('loggedInUserId', jsonData.userId);",
              "    pm.collectionVariables.set('corporateId', jsonData.corporateId);",
              "",
              "    // The auth token is typically in the response header or body.",
              "    // Adjust the field name below if the token field differs in your API.",
              "    var token = jsonData.token || jsonData.accessToken || jsonData.bearerToken || '';",
              "    pm.collectionVariables.set('authToken', token);",
              "",
              "    console.log('Login successful.');",
              "    console.log('userId: ' + jsonData.userId);",
              "    console.log('corporateId: ' + jsonData.corporateId);",
              "    console.log('authToken: ' + token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",    "value": "application/json" },
          { "key": "x-transaction-id","value": "{{txnId_login}}" },
          { "key": "x-session-id",    "value": "session-login-{{$randomUUID}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\",\n  \"corporateId\": {{loginCorporateId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/Auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["Auth", "login"]
        }
      }
    },
    {
      "name": "2. Create Corporate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate unique x-transaction-id",
              "pm.collectionVariables.set('txnId_corp', require('uuid').v4());",
              "",
              "// Build unique corporate code using testCaseId",
              "var testCaseId = pm.iterationData.get('testCaseId');",
              "var corpCode = 'PartialCurr_' + testCaseId.replace('TC_', '');",
              "pm.collectionVariables.set('corpCode', corpCode);",
              "",
              "// Map timezone offset to timezone abbreviation",
              "var corpTimezone = pm.iterationData.get('corpTimezone');",
              "var timezoneMap = {",
              "    'UTC-05:00': 'EDT',",
              "    'UTC+05:30': 'IST',",
              "    'UTC+00:00': 'UTC',",
              "    'UTC+01:00': 'CET',",
              "    'UTC+04:00': 'GST',",
              "    'UTC+08:00': 'SGT',",
              "    'UTC+09:00': 'JST',",
              "    'UTC+10:00': 'AEST'",
              "};",
              "var mappedTimezone = timezoneMap[corpTimezone] || 'UTC';",
              "pm.collectionVariables.set('mappedCorpTimezone', mappedTimezone);",
              "",
              "// Map currency to symbol",
              "var corpCurrency = pm.iterationData.get('corpCurrency');",
              "pm.collectionVariables.set('corpCurrencySymbol', corpCurrency || 'USD');",
              "",
              "// Map country to dial code",
              "var corpCountry = pm.iterationData.get('corpCountry');",
              "var dialCodeMap = {",
              "    'USA': '+1', 'IND': '+91', 'GBR': '+44',",
              "    'SGP': '+65', 'AUS': '+61', 'DEU': '+49',",
              "    'ARE': '+971', 'KOR': '+82', 'JPN': '+81'",
              "};",
              "pm.collectionVariables.set('corpDialCode', dialCodeMap[corpCountry] || '+1');",
              "",
              "console.log('[' + testCaseId + '] Creating Corporate: ' + corpCode);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create Corporate - Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Create Corporate - Success', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.successCode).to.eql(1);",
              "    pm.collectionVariables.set('corporateId', jsonData.corporateId);",
              "    console.log('Corporate ID set: ' + jsonData.corporateId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",     "value": "application/json" },
          { "key": "Authorization",    "value": "Bearer {{authToken}}" },
          { "key": "x-transaction-id", "value": "{{txnId_corp}}" },
          { "key": "x-session-id",     "value": "session-{{corpCode}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corporateCode\": \"{{corpCode}}\",\n  \"corporateName\": \"Corp {{corpCode}}\",\n  \"corporateDescription\": \"Auto created for {{testCaseId}}\",\n  \"corporateStatus\": \"Active\",\n  \"firstName\": \"Auto\",\n  \"lastName\": \"Corp\",\n  \"addressLine1\": \"Test Address Line 1\",\n  \"addressLine2\": null,\n  \"city\": \"Test City\",\n  \"stateProvince\": \"Test State\",\n  \"postalCode\": \"10001\",\n  \"countryCode\": \"{{corpCountry}}\",\n  \"dialCode\": \"{{corpDialCode}}\",\n  \"dialCountryCode\": \"{{corpCountry}}\",\n  \"mobileNumber\": \"9000000001\",\n  \"contactEmail\": \"corp.{{corpCode}}@test.com\",\n  \"timezone\": \"{{mappedCorpTimezone}}\",\n  \"dateFormat\": \"{{corpDateFormat}}\",\n  \"timeFormat\": \"hh:mm a\",\n  \"enableSsoLogin\": false,\n  \"b2cInstance\": null,\n  \"b2cDomainName\": null,\n  \"b2cSigninSignupPolicy\": null,\n  \"b2cClientId\": null,\n  \"sessionTimeoutLimit\": null,\n  \"enableMfa\": false,\n  \"otpMaxAttempts\": null,\n  \"otpExpirationTime\": null,\n  \"passwordExpirationPeriod\": null,\n  \"currencySymbol\": \"{{corpCurrencySymbol}}\",\n  \"currencyRoundOff\": \"{{corpDecimals}}\",\n  \"createdBy\": {{loggedInUserId}},\n  \"requestedBy\": {{loggedInUserId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/Corporates/createcorporate",
          "host": ["{{baseUrl}}"],
          "path": ["Corporates", "createcorporate"]
        }
      }
    },
