    {
      "name": "1. Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var uuid = require('uuid');",
              "pm.collectionVariables.set('txnId_login', uuid.v4());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login - Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Login - Success and credentials extracted', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.successCode).to.eql(1);",
              "    pm.collectionVariables.set('loggedInUserId', jsonData.userId);",
              "    pm.collectionVariables.set('corporateId',    jsonData.corporateId);",
              "    // ⚠️ Adjust field name if your API returns token under a different key",
              "    var token = jsonData.token || jsonData.accessToken || jsonData.bearerToken || '';",
              "    pm.collectionVariables.set('authToken', token);",
              "    console.log('✅ Login OK | userId: ' + jsonData.userId + ' | corporateId: ' + jsonData.corporateId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-transaction-id",
            "value": "{{txnId_login}}"
          },
          {
            "key": "x-session-id",
            "value": "session-login"
          }
        ],
        "body": {
          "mode": "raw",
