    {
      "name": "2. Create Corporate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ── UUID ──────────────────────────────────────────────────────",
              "var uuid = require('uuid');",
              "pm.collectionVariables.set('txnId_corp', uuid.v4());",
              "",
              "// ── Shared lookup maps ────────────────────────────────────────",
              "// ISO 3166-1 alpha-3 → alpha-2 (for dialCountryCode, max 5 chars)",
              "var alpha3ToAlpha2 = {",
              "    'USA': 'US', 'IND': 'IN', 'GBR': 'GB', 'SGP': 'SG',",
              "    'AUS': 'AU', 'DEU': 'DE', 'ARE': 'AE', 'KOR': 'KR', 'JPN': 'JP'",
              "};",
              "// Dial codes",
              "var dialCodeMap = {",
              "    'USA': '+1',  'IND': '+91', 'GBR': '+44', 'SGP': '+65',",
              "    'AUS': '+61', 'DEU': '+49', 'ARE': '+971','KOR': '+82', 'JPN': '+81'",
              "};",
              "// Timezone map (UTC offset string → abbreviation accepted by API)",
              "var timezoneMap = {",
              "    'UTC-05:00': 'EDT', 'UTC+05:30': 'IST', 'UTC+00:00': 'UTC',",
              "    'UTC+01:00': 'CET', 'UTC+04:00': 'GST', 'UTC+08:00': 'SGT',",
              "    'UTC+09:00': 'JST', 'UTC+10:00': 'AEST'",
              "};",
              "",
              "// ── NULL-SAFE fetch from iterationData ────────────────────────",
              "var testCaseId   = pm.iterationData.get('testCaseId')   || 'STANDALONE';",
              "var corpTimezone = pm.iterationData.get('corpTimezone') || 'UTC+00:00';",
              "var corpCurrency = pm.iterationData.get('corpCurrency') || 'USD';",
              "var corpCountry  = pm.iterationData.get('corpCountry')  || 'USA';",
              "var corpDateFmt  = pm.iterationData.get('corpDateFormat')|| 'MM/DD/YYYY';",
              "var corpDecimals = pm.iterationData.get('corpDecimals') != null",
              "                   ? String(pm.iterationData.get('corpDecimals')) : '2';",
              "",
              "// ── Derived values ────────────────────────────────────────────",
              "var corpCode    = 'PC_' + testCaseId.replace('TC_', '');",
              "var alpha2      = alpha3ToAlpha2[corpCountry] || 'US';",
              "var dialCode    = dialCodeMap[corpCountry]    || '+1';",
              "var timezone    = timezoneMap[corpTimezone]   || 'UTC';",
              "",
              "// ── Store to collection variables ─────────────────────────────",
              "pm.collectionVariables.set('corpCode',           corpCode);",
              "pm.collectionVariables.set('corpCountryCode',    corpCountry);   // alpha-3, used in countryCode field",
              "pm.collectionVariables.set('corpDialCode',       dialCode);",
              "pm.collectionVariables.set('corpDialCountryCode',alpha2);        // alpha-2, used in dialCountryCode field",
              "pm.collectionVariables.set('mappedCorpTimezone', timezone);",
              "pm.collectionVariables.set('corpCurrencySymbol', corpCurrency);",
              "pm.collectionVariables.set('corpDateFormat',     corpDateFmt);",
              "pm.collectionVariables.set('corpDecimals',       corpDecimals);",
              "",
              "console.log('[' + testCaseId + '] Creating Corporate: ' + corpCode +",
              "    ' | country=' + corpCountry + ' | dialCC=' + alpha2 +",
              "    ' | tz=' + timezone + ' | dateFormat=' + corpDateFmt + ' | decimals=' + corpDecimals);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create Corporate - Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Create Corporate - Success', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.successCode).to.eql(1);",
              "    pm.collectionVariables.set('corporateId', jsonData.corporateId);",
              "    console.log('✅ Corporate ID: ' + jsonData.corporateId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "x-transaction-id",
            "value": "{{txnId_corp}}"
          },
          {
            "key": "x-session-id",
            "value": "session-{{corpCode}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corporateCode\": \"{{corpCode}}\",\n  \"corporateName\": \"Corp {{corpCode}}\",\n  \"corporateDescription\": \"Auto created for {{testCaseId}}\",\n  \"corporateStatus\": \"Active\",\n  \"firstName\": \"Auto\",\n  \"lastName\": \"Corp\",\n  \"addressLine1\": \"Test Address Line 1\",\n  \"addressLine2\": null,\n  \"city\": \"Test City\",\n  \"stateProvince\": \"Test State\",\n  \"postalCode\": \"10001\",\n  \"countryCode\": \"{{corpCountryCode}}\",\n  \"dialCode\": \"{{corpDialCode}}\",\n  \"dialCountryCode\": \"{{corpDialCountryCode}}\",\n  \"mobileNumber\": \"9000000001\",\n  \"contactEmail\": \"corp.{{corpCode}}@test.com\",\n  \"timezone\": \"{{mappedCorpTimezone}}\",\n  \"dateFormat\": \"{{corpDateFormat}}\",\n  \"timeFormat\": \"hh:mm a\",\n  \"enableSsoLogin\": false,\n  \"b2cInstance\": null,\n  \"b2cDomainName\": null,\n  \"b2cSigninSignupPolicy\": null,\n  \"b2cClientId\": null,\n  \"sessionTimeoutLimit\": null,\n  \"enableMfa\": false,\n  \"otpMaxAttempts\": null,\n  \"otpExpirationTime\": null,\n  \"passwordExpirationPeriod\": null,\n  \"currencySymbol\": \"{{corpCurrencySymbol}}\",\n  \"currencyRoundOff\": \"{{corpDecimals}}\",\n  \"createdBy\": {{loggedInUserId}},\n  \"requestedBy\": {{loggedInUserId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/Corporates/createcorporate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Corporates",
            "createcorporate"
          ]
        }
      }
    },
