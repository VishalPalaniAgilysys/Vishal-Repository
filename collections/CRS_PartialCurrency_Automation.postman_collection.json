              "",
              "// Dynamic rate plan name",
              "var rpName = 'RatePlan ' + testCaseId + ' ' + suffix;",
              "pm.collectionVariables.set('ratePlanName', rpName);",
              "",
              "// Effective start date = today in YYYY-MM-DD",
              "var today = new Date();",
              "var yyyy = today.getUTCFullYear();",
              "var mm = String(today.getUTCMonth() + 1).padStart(2, '0');",
              "var dd = String(today.getUTCDate()).padStart(2, '0');",
              "pm.collectionVariables.set('rpEffectiveStartDate', yyyy + '-' + mm + '-' + dd);",
              "",
              "// Currency from hotel (rpCurrency column in test data)",
              "var rpCurrency = pm.iterationData.get('rpCurrency');",
              "pm.collectionVariables.set('rpCurrencyCode', rpCurrency || 'USD');",
              "",
              "console.log('[' + testCaseId + '] Creating Rate Plan: ' + rpCode + ' | HotelId: ' + pm.collectionVariables.get('hotelId') + ' | Currency: ' + (rpCurrency || 'USD'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create Rate Plan - Status 200', function () {",
