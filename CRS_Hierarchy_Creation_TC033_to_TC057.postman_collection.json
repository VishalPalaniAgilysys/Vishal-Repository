    {
      "name": "1. Create Corporate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Build unique corporate code using testCaseId",
              "var testCaseId = pm.iterationData.get(\"testCaseId\"); // e.g. TC_033",
              "var corpCode = \"CorpSameCurr_\" + testCaseId.replace(\"TC_\", \"\") + \"_\" + Date.now().toString().slice(-6);",
              "pm.collectionVariables.set(\"corpCode\", corpCode);",
              "",
              "// Map timezone to timezone string",
              "var corpTimezone = pm.iterationData.get(\"corpTimezone\");",
              "var timezoneMap = {",
              "    \"UTC-05:00\": \"EDT\",",
              "    \"UTC+05:30\": \"IST\",",
              "    \"UTC+09:00\": \"JST\",",
              "    \"UTC+01:00\": \"CET\",",
              "    \"UTC+00:00\": \"GMT\",",
              "    \"UTC+04:00\": \"GST\",",
              "    \"UTC+08:00\": \"SGT\",",
              "    \"UTC+10:00\": \"AEST\",",
              "    \"UTC+09:00\": \"KST\",",
              "    \"UTC+03:00\": \"EAT\",",
              "    \"UTC+02:00\": \"SAST\",",
              "    \"UTC-05:00\": \"CDT\",",
              "    \"UTC+12:00\": \"NZST\",",
              "    \"UTC+02:00\": \"CAT\"",
              "};",
              "var mappedTimezone = timezoneMap[corpTimezone] || \"UTC\";",
              "pm.collectionVariables.set(\"mappedCorpTimezone\", mappedTimezone);",
              "",
              "// Map currency to symbol",
              "var corpCurrency = pm.iterationData.get(\"corpCurrency\");",
              "var currencySymbolMap = {",
              "    \"USD\": \"USD\",",
              "    \"INR\": \"INR\",",
              "    \"JPY\": \"JPY\",",
              "    \"EUR\": \"EUR\",",
              "    \"GBP\": \"GBP\",",
              "    \"AED\": \"AED\",",
              "    \"SGD\": \"SGD\",",
              "    \"MYR\": \"MYR\",",
              "    \"SGD\": \"SGD\",",
              "    \"JPY\": \"JPY\",",
              "    \"SAR\": \"SAR\",",
              "    \"EUR\": \"EUR\",",
              "    \"ZAR\": \"ZAR\",",
              "    \"USD\": \"USD\",",
              "    \"AUD\": \"AUD\",",
              "    \"KRW\": \"KRW\",",
              "    \"SAR\": \"SAR\",",
              "    \"NZD\": \"NZD\",",
              "    \"ZAR\": \"ZAR\"",
              "};",
              "var currencySymbol = currencySymbolMap[corpCurrency] || corpCurrency;",
              "pm.collectionVariables.set(\"corpCurrencySymbol\", currencySymbol);",
              "",
              "// Map country to dial code",
              "var corpCountry = pm.iterationData.get(\"corpCountry\");",
              "var dialCodeMap = {",
              "    \"USA\": \"+1\",",
              "    \"IND\": \"+91\",",
              "    \"JPN\": \"+81\",",
              "    \"DEU\": \"+49\",",
              "    \"GBR\": \"+44\",",
              "    \"ARE\": \"+971\",",
              "    \"SGP\": \"+65\",",
              "    \"MYS\": \"+60\",",
              "    \"SAU\": \"+966\",",
              "    \"ZAF\": \"+27\",",
              "    \"AUS\": \"+61\",",
              "    \"KOR\": \"+82\",",
              "    \"NZL\": \"+64\"",
              "};",
              "var dialCode = dialCodeMap[corpCountry] || \"+1\";",
              "pm.collectionVariables.set(\"corpDialCode\", dialCode);",
              "",
              "console.log(\"Creating Corporate with code: \" + corpCode);",
              "console.log(\"Corp Timezone: \" + mappedTimezone + \" | Currency: \" + currencySymbol + \" | Country: \" + corpCountry);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Create Corporate - Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Create Corporate - Success\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.successCode).to.eql(1);",
              "    pm.collectionVariables.set(\"corporateId\", jsonData.corporateId);",
              "    console.log(\"✓ Corporate ID set: \" + jsonData.corporateId);",
              "    console.log(\"✓ Corporate Code: \" + pm.collectionVariables.get(\"corpCode\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
