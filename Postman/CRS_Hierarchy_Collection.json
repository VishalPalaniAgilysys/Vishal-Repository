              "script": {
                "type": "text/javascript",
                "exec": [
                  "function generateGUID() {",
                  "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    var r = Math.random() * 16 | 0;",
                  "    var v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "  });",
                  "}",
                  "pm.collectionVariables.set('transactionId', generateGUID());",
                  "",
                  "// TC_002 - Hotel: Country IND | Currency INR | TimeZone IST | DateFormat DD/MM/YYYY | TimeFormat 12-Hour | Decimals 2",
                  "var ts = Date.now().toString().slice(-6);",
                  "var rnd = Math.random().toString(36).substring(2,5).toUpperCase();",
                  "var hotelCode = 'HTL-TC002-' + ts + rnd;",
                  "var hotelName = 'Hotel TC002 ' + ts + rnd;",
                  "pm.collectionVariables.set('hotelCode', hotelCode);",
                  "pm.collectionVariables.set('hotelName', hotelName);",
                  "pm.collectionVariables.set('hotelCountry', 'IND');",
                  "pm.collectionVariables.set('hotelDialCode', '+91');",
                  "console.log('TC_002 - HotelCode: ' + hotelCode + ' | HotelName: ' + hotelName);"
                ]
              }
            },
