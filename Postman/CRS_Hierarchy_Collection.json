      "item": [
        {
          "name": "01 - Create Corporate",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function generateGUID() {",
                  "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    var r = Math.random() * 16 | 0;",
                  "    var v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "  });",
                  "}",
                  "pm.collectionVariables.set('transactionId', generateGUID());",
                  "",
                  "// TC_001 - Generate unique CorpCode and CorpName",
                  "// Corp Country: USA | Currency: USD | TimeZone: UTC-05:00 | DateFormat: MM/DD/YYYY | TimeFormat: 12-Hour | Decimals: 2",
                  "var ts = Date.now().toString().slice(-6);",
                  "var rnd = Math.random().toString(36).substring(2,5).toUpperCase();",
                  "var corpCode = 'CORP-TC001-' + ts + rnd;",
                  "var corpName = 'Corp TC001 ' + ts + rnd;",
                  "pm.collectionVariables.set('corpCode', corpCode);",
                  "pm.collectionVariables.set('corpName', corpName);",
                  "pm.collectionVariables.set('corpCountry', 'USA');",
                  "pm.collectionVariables.set('corpDialCode', '+1');",
                  "console.log('TC_001 - CorpCode: ' + corpCode + ' | CorpName: ' + corpName);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC001 Corporate - Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('TC001 Corporate - successCode = 1', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.successCode).to.eql(1);",
                  "  pm.collectionVariables.set('corporateId', String(j.corporateId));",
                  "  console.log('TC_001 Corporate ID: ' + j.corporateId);",
                  "});"
                ]
              }
            }
          ],
